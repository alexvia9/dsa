# Supabase — copy to `.env` and restart `npm run dev`.
#
# In Supabase: Project Settings → API
#   Project URL          → VITE_SUPABASE_URL
#   Publishable key      → VITE_SUPABASE_ANON_KEY   (safe in the browser)
#   Secret key           → DO NOT put in this file (server-only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
