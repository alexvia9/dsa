# Copy to `.env` (or `.env.local`) and restart `npm run dev`.
# Both files are gitignored; `.env` is fine if you already use it for Supabase.

# Supabase (optional — cloud sync + live Market Index refresh via edge function)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Market Index (Stooq SPY data) — server-side only, never VITE_* ---
#
# Stooq has NO api signup page. After a captcha you copy their CSV download URL.
# Run: npm run stooq-setup
#
# Easiest: paste the full link from Stooq (after captcha + "Download data in csv file"):
STOOQ_SPY_CSV_URL=
#
# Or paste only the apikey= value from that URL:
STOOQ_API_KEY=
